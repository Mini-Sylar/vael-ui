{
  "name": "vael-ui",
  "version": "0.1.4",
  "description": "Animation-agnostic Vue 3 UI library with full Vue Vapor support.",
  "keywords": [
    "animation-agnostic",
    "component-library",
    "design-system",
    "headless-ui",
    "ui",
    "ui-library",
    "vapor",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/Mini-Sylar/vael-ui#readme",
  "bugs": {
    "url": "https://github.com/Mini-Sylar/vael-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mini-Sylar/vael-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./vapor": {
      "types": "./dist/vapor/index.d.ts",
      "default": "./dist/vapor/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node -e \"require('fs').copyFileSync('../../README.md', './README.md')\"",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "check:dts": "vue-tsc --noEmit -p dts-check/tsconfig.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@vueuse/core": "^14.3.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "motion-v": "^2.3.0",
    "playwright": "^1.62.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0",
    "vue": "3.6.0-rc.2",
    "vue-component-type-helpers": "^3.3.8",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "vue": "^3.5.0 || ^3.6.0-0"
  }
}
