{
  "name": "vael-ui",
  "version": "0.4.8",
  "description": "Animation-agnostic Vue 3 UI library with full Vue Vapor support.",
  "keywords": [
    "animation-agnostic",
    "component-library",
    "design-system",
    "headless-ui",
    "ui",
    "ui-library",
    "vapor",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/Mini-Sylar/vael-ui#readme",
  "bugs": {
    "url": "https://github.com/Mini-Sylar/vael-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mini-Sylar/vael-ui.git"
  },
  "funding": "https://github.com/sponsors/Mini-Sylar",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "vapor": {
        "types": "./dist/vapor/index.d.ts",
        "browser": "./dist/vapor/index.js",
        "node": "./dist/vapor-server/index.js",
        "workerd": "./dist/vapor-server/index.js",
        "worker": "./dist/vapor-server/index.js",
        "edge-light": "./dist/vapor-server/index.js",
        "deno": "./dist/vapor-server/index.js",
        "bun": "./dist/vapor-server/index.js",
        "default": "./dist/vapor/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vapor": {
      "types": "./dist/vapor/index.d.ts",
      "browser": "./dist/vapor/index.js",
      "node": "./dist/vapor-server/index.js",
      "workerd": "./dist/vapor-server/index.js",
      "worker": "./dist/vapor-server/index.js",
      "edge-light": "./dist/vapor-server/index.js",
      "deno": "./dist/vapor-server/index.js",
      "bun": "./dist/vapor-server/index.js",
      "default": "./dist/vapor/index.js"
    },
    "./motion": {
      "vapor": {
        "types": "./dist/vapor/motion.d.ts",
        "browser": "./dist/vapor/motion.js",
        "node": "./dist/vapor-server/motion.js",
        "workerd": "./dist/vapor-server/motion.js",
        "worker": "./dist/vapor-server/motion.js",
        "edge-light": "./dist/vapor-server/motion.js",
        "deno": "./dist/vapor-server/motion.js",
        "bun": "./dist/vapor-server/motion.js",
        "default": "./dist/vapor/motion.js"
      },
      "types": "./dist/motion/index.d.ts",
      "browser": "./dist/motion/index.js",
      "node": "./dist/vapor-server/motion.js",
      "workerd": "./dist/vapor-server/motion.js",
      "worker": "./dist/vapor-server/motion.js",
      "edge-light": "./dist/vapor-server/motion.js",
      "deno": "./dist/vapor-server/motion.js",
      "bun": "./dist/vapor-server/motion.js",
      "default": "./dist/motion/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "default": "./dist/resolver/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/index.d.ts",
      "default": "./dist/nuxt/index.js"
    },
    "./style.css": "./dist/style-entry.css",
    "./layers.css": "./dist/layers.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "node ../scripts/generate-resolver-manifest.mjs",
    "build": "pnpm gen && tsdown && node -e \"const fs = require('fs'); fs.copyFileSync('../../README.md', './README.md'); fs.copyFileSync('./src/layers.css', './dist/layers.css')\"",
    "dev": "pnpm gen && tsdown --watch --no-clean --no-report",
    "test": "pnpm gen && vitest run",
    "test:spikes": "vitest run --config vitest.spikes.config.ts",
    "check:dts": "vue-tsc --noEmit -p dts-check/tsconfig.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@vueuse/core": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.1",
    "@tsdown/css": "^0.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "motion-v": "^2.7.0",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vue": "3.6.0-rc.13",
    "vue-component-type-helpers": "3.3.11",
    "vue-tsc": "3.3.11"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "vue": "^3.5.0 || ^3.6.0-0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  }
}
