{
  "name": "vapor-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:spikes": "vitest run --config vitest.spikes.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "gen": "node ../scripts/generate-vapor.mjs",
    "dev": "node ../scripts/watch-vapor.mjs",
    "build": "pnpm gen && NODE_ENV=production tsdown && node ../scripts/emit-vapor-types.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@vueuse/core": "^15.0.0",
    "vael-ui": "workspace:*",
    "vue": "3.6.0-rc.12"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.11"
  }
}
