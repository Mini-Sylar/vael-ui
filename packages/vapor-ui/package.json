{
  "name": "vapor-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "gen": "node ../scripts/generate-vapor.mjs",
