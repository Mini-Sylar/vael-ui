  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@vueuse/core": "^14.4.0",
    "vael-ui": "workspace:*",
    "vue": "3.6.0-rc.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
